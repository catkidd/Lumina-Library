# ==============================================================================
# PROFESSIONAL JAVA, SPRING BOOT & REACT JS GITIGNORE
# ==============================================================================
# Tailored for Java & Node.js workspaces, IDE configurations, build systems,
# local database properties, logs, environment variables, and secure keys.
# Standard: Enterprise Standards & Technical Writing Guidelines Compliant

# ------------------------------------------------------------------------------
# 1. Compiled Binary and Class Files
# ------------------------------------------------------------------------------
*.class
*.vars
*.pyc

# Java Mobile Tools (J2ME)
.mtj.tmp/

# Package Files (JAR, WAR, EAR, NAR)
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# ------------------------------------------------------------------------------
# 2. Build Tools & Dependencies (Maven & Gradle)
# ------------------------------------------------------------------------------
# Maven
target/
pom.xml.tag
pom.xml.next
pom.xml.releaseBackup
release.properties
dependency-reduced-pom.xml
buildNumber.properties
.mvn/timing.properties
.mvn/wrapper/maven-wrapper.jar

# Gradle
bin/
build/
.gradle/
gradle-app.setting
!gradle-wrapper.jar

# ------------------------------------------------------------------------------
# 3. IDEs, Editors & Project Settings
# ------------------------------------------------------------------------------
# IntelliJ IDEA
.idea/
*.iws
*.iml
*.ipr
out/

# Spring Tool Suite (STS) & Eclipse
.metadata
.classpath
.project
.settings/
.factorypath
.springBeans
.sts4-cache
*.launch
.apt_generated

# NetBeans
/nbproject/private/
/nbbuild/
/dist/
/nbdist/
/.nb-gradle/

# Visual Studio Code
.vscode/
!.vscode/extensions.json
*.code-workspace
.history/

# Generic Editors
*.sublime-project
*.sublime-workspace
.tmproj
.esproj
*.swp
*.swo
*~

# ------------------------------------------------------------------------------
