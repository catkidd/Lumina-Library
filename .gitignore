# ------------------------------------------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.VolumeIcon.icns
.com.apple.timemachine.donotpresent

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.lnk
*.cab
[Dd]esktop.ini
$RECYCLE.BIN/

# Linux
.fuse_hidden*
.directory
.Trash-*
.nfs*

# ------------------------------------------------------------------------------
# 5. Frontend & Node.js Workspaces
# ------------------------------------------------------------------------------
node_modules/
/frontend/dist/
/frontend/dist-ssr/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ------------------------------------------------------------------------------
# 6. Logging, Auditing & Performance Tracing
# ------------------------------------------------------------------------------
*.log
*.log.*
/logs/
/log/

# ------------------------------------------------------------------------------
# 7. Environment Configurations & Secrets
# ------------------------------------------------------------------------------
# Never check in credentials, local paths, or environment secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem
*.key
*.jks
*.p12
*.keystore
secrets/
